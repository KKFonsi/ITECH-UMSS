NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173
PG_POOL_MAX=5
PGSSL_MODE=verify-full
# Optional PEM certificate authority, with newlines escaped as \n if needed.
# PG_CA_CERT=
# Or save the downloaded Supabase database CA at backend/certs/supabase-ca.crt.
# PG_CA_CERT_PATH=certs/supabase-ca.crt
# For a local PostgreSQL test server only: PGSSL_MODE=disable
