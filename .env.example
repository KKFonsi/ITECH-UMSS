# ─── Backend ──────────────────────────────────────────────────────────────────
# Server port (default: 3000)
PORT=3000

# Node environment: development | production
NODE_ENV=development

# PostgreSQL connection string (required for DB features)
# DATABASE_URL=postgresql://user:password@host:5432/umss

# Comma-separated list of allowed CORS origins in production
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com

# Logging level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ─── Frontend (prefix with VITE_ to expose to client) ─────────────────────────
# Backend API base URL (used by the frontend fetch client)
# VITE_API_BASE_URL=http://localhost:3000
