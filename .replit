modules = ["nodejs-22"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
build = ["sh", "-c", "cd frontend && npm install && npm run build && cd ../backend && npm install && npm run build"]
run = ["sh", "-c", "cd backend && npm start"]

[deployment.postBuild]
args = ["echo", "Build complete"]

[agent]
stack = "nodejs"
expertMode = true

[workflows]
runButton = "Dev"

[[workflows.workflow]]
name = "Dev"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && npm install && npm run dev"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm install && npm run dev"

[[ports]]
localPort = 5173
externalPort = 80

[[ports]]
localPort = 3000
externalPort = 3000
